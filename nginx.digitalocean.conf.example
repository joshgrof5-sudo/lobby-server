# Add a NEW site to an existing host Nginx. Replace baseball.example.com
# with the chosen DNS name. Keep the other game's sites and upstreams.
# This HTTP bootstrap becomes HTTPS after certificate setup.
server {
    listen 80;
    server_name baseball.example.com;
    client_max_body_size 8k;

    location / {
        proxy_pass http://127.0.0.1:18081;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 70s;
    }
}
